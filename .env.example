# Configuration locale du copilote.
# Copiez ce fichier en .env (ignoré par Git), puis adaptez les valeurs.
# Aucun secret ici : ce fichier est public.

# Adresse du serveur Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modèle de génération local (changer de modèle = changer cette ligne) ; le modèle du mode distant est LLM_API_MODEL, plus bas
# qwen3:4b-instruct a été retenu à la séance 5 (eval/results_v1.md) ; ministral-3:3b reste possible
LLM_MODEL=qwen3:4b-instruct
# Taille du contexte en tokens (passages + question + réponse)
LLM_NUM_CTX=8192
# Nombre de couches du modèle placées sur la carte graphique : 99 = toutes (le plus rapide).
# Mesuré : ministral-3:3b avec 8192 tokens de contexte occupe 3,87 Go sur 4 Go.
# En cas d'erreur « out of memory » : baissez LLM_NUM_CTX (6144 ou 4096) ou LLM_NUM_GPU (par exemple 20),
# ou laissez LLM_NUM_GPU vide pour laisser Ollama choisir (environ 4 fois plus lent).
LLM_NUM_GPU=99
# Température basse : réponses plus stables et plus fidèles aux passages
LLM_TEMPERATURE=0.1
# Longueur maximale d'une réponse, en tokens (une réponse coupée est signalée)
LLM_MAX_TOKENS=2000

# Recherche (mesurée à la séance 5, voir eval/results_v1.md)
# vector = par le sens (retenu) ; hybrid = sens + mots-clés BM25 (moins bon sur les questions v1)
SEARCH_MODE=vector
# Lexique qui ajoute le vocabulaire juridique à la question : all (retenu), keywords ou off
SEARCH_LEXICON=all
# Au plus N passages d'un même article parmi ceux donnés au modèle (vide = pas de limite)
SEARCH_MAX_PER_ARTICLE=2
# Nombre de passages donnés au modèle (8 mesuré à la séance 6 : plus lent, sans gain avec le lexique)
SEARCH_K=5
# Quand un paragraphe d'un article découpé est retenu, ajouter aussi le 1er paragraphe de l'article, qui pose souvent la règle (on/off)
SEARCH_FIRST_PARAGRAPH=on
# Reranker (cross-encoder BAAI/bge-reranker-v2-m3 sur CPU), option désactivée (eval/results_v4.md, section 7 ; README) :
# on demande pip install -e .[rerank] (torch et transformers) et coûte 22 à 33 s de plus par question ; avec le modèle local,
# il améliore la recherche mais a créé deux réponses dangereuses (q09, q10) en en corrigeant trois.
SEARCH_RERANK=off
# SEARCH_RERANK_CANDIDATES=20
# Reformulation de la question (séance 7 ter, eval/results_v6.md) : le modèle du mode choisi ajoute des termes juridiques
# à la question avant la recherche (jamais une conclusion). off par défaut ; en mode distant, la question part une fois de plus chez Groq.
SEARCH_REWRITE=off
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Contrôle de pertinence : un second appel court vérifie que les extraits répondent directement à la question (on/off)
ANSWER_JUDGE=on

# Modèle d'embeddings multilingue
EMBEDDING_MODEL=bge-m3

# Matériel utilisé pour les embeddings : gpu (carte graphique) ou cpu (processeur)
# - pour construire l'index :
INDEX_EMBEDDING_DEVICE=gpu
# - pour les questions : cpu, afin de laisser la carte graphique au modèle de génération
QUERY_EMBEDDING_DEVICE=cpu

# Mode distant (optionnel) : ollama = local, par défaut (rien ne sort de l'ordinateur) ; openai = API compatible OpenAI,
# ici le niveau gratuit de Groq avec qwen/qwen3.8-27b (modèle en preview : il peut disparaître). Voir le README.
# En mode distant, la question et les extraits de loi sont envoyés à Groq : jamais de données personnelles.
# On peut aussi choisir le mode pour une seule question : scripts\ask.py --backend openai "…"
LLM_BACKEND=ollama
# Modèle utilisé en mode distant (LLM_MODEL reste le modèle local)
# LLM_API_MODEL=qwen/qwen3.8-27b
# LLM_API_BASE_URL=https://api.groq.com/openai/v1
# Nom de la variable qui contient la clé (la clé elle-même va dans GROQ_API_KEY, jamais dans Git ni dans ce fichier)
# LLM_API_KEY_ENV=GROQ_API_KEY
# GROQ_API_KEY=
# Raisonnement du modèle distant (reasoning_effort) ; vide = none pour qwen/qwen3.8-27b, rien d'envoyé pour les autres
# LLM_API_REASONING_EFFORT=
